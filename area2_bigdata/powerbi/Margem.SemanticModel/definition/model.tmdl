model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["PastaDados","dim_bairro","dim_estacao","dim_morador","fato_alerta","fato_leitura_hora","fato_ocorrencia","_Medidas"]

annotation PBI_ProTooling = ["DevMode"]

ref table dim_bairro
ref table dim_estacao
ref table dim_morador
ref table fato_alerta
ref table fato_leitura_hora
ref table fato_ocorrencia
ref table dim_data
ref table _Medidas

ref cultureInfo pt-BR

