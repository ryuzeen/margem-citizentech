	partition dim_bairro = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaDados & "dim_bairro.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Nulos = Table.TransformColumns(Cabecalho, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(Nulos, {{"bairro_id", type text}, {"nome", type text}, {"lat", type number}, {"lng", type number}, {"populacao_estimada", Int64.Type}, {"domicilios_area_risco", Int64.Type}, {"estacao_id", type text}}, [Culture = "en-US"])
				in
				    Tipos

	annotation PBI_ResultType = Table

