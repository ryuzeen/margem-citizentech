table dim_bairro
	lineageTag: e937ff3f-4a9d-5417-926e-42798267e56e

	column bairro_id
		dataType: string
		lineageTag: 41bfeaf5-1e21-5c4e-b409-67203ba9a4fd
		summarizeBy: none
		sourceColumn: bairro_id

	column nome
		dataType: string
		lineageTag: ead623b4-cd32-5947-98e3-7d706a51ce15
		summarizeBy: none
		sourceColumn: nome

	column lat
		dataType: double
		formatString: #,0.0###
		lineageTag: 14f77a4b-5497-5bb1-a086-a32ec893506d
		summarizeBy: none
		sourceColumn: lat

	column lng
		dataType: double
		formatString: #,0.0###
		lineageTag: 20b7ea6d-c843-5187-a7ce-b3b819234c0d
		summarizeBy: none
		sourceColumn: lng

	column populacao_estimada
		dataType: int64
		formatString: 0
		lineageTag: fbe83d23-217e-5464-87d0-34edb82cb709
		summarizeBy: sum
		sourceColumn: populacao_estimada

	column domicilios_area_risco
		dataType: int64
