	partition dim_estacao = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaDados & "dim_estacao.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Nulos = Table.TransformColumns(Cabecalho, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(Nulos, {{"estacao_id", type text}, {"bairro_id", type text}, {"nome", type text}, {"lat", type number}, {"lng", type number}, {"altura_instalacao_cm", Int64.Type}, {"cota_alerta_cm", Int64.Type}, {"cota_transbordo_cm", Int64.Type}, {"nivel_base_cm", Int64.Type}}, [Culture = "en-US"])
				in
				    Tipos

	annotation PBI_ResultType = Table

