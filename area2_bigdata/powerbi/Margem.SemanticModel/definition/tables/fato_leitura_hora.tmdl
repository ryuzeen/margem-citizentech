	column hora_idx
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 1878a92c-e8f1-53d8-ba8b-eadf1f7cdb72
		summarizeBy: none
		sourceColumn: hora_idx

	column seq
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 5cb6a351-f9cd-5e04-8684-91125e968875
		summarizeBy: none
		sourceColumn: seq

	column lacuna_antes =
			-- 1 quando a leitura anterior da estação não é a hora imediatamente anterior (lacuna ou 1ª leitura)
			VAR IdxAnterior =
			    LOOKUPVALUE (
			        fato_leitura_hora[hora_idx],
			        fato_leitura_hora[estacao_id], fato_leitura_hora[estacao_id],
			        fato_leitura_hora[seq], fato_leitura_hora[seq] - 1
			    )
			RETURN
			    IF ( ISBLANK ( IdxAnterior ) || fato_leitura_hora[hora_idx] - IdxAnterior > 1, 1, 0 )
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 1e3ba69f-bd54-5694-86a8-18682bb43690
		summarizeBy: none

	column nivel_ordem =
			SWITCH (
			    fato_leitura_hora[nivel_risco],
			    "observacao", 0,
			    "atencao", 1,
			    "alerta", 2,
			    "alerta_maximo", 3,
			    BLANK ()
			)
		dataType: int64
		formatString: 0
		lineageTag: 0461c044-10dc-5284-aced-06d33824c9c7
		summarizeBy: none

	column inicio_transbordo =
			-- 1 na primeira hora de cada sequência com nível >= cota de transbordo (compara com a leitura anterior)
			VAR Cota = RELATED ( dim_estacao[cota_transbordo_cm] )
			VAR NivelAnterior =
			    LOOKUPVALUE (
			        fato_leitura_hora[nivel_cm],
			        fato_leitura_hora[estacao_id], fato_leitura_hora[estacao_id],
			        fato_leitura_hora[seq], fato_leitura_hora[seq] - 1
			    )
			RETURN
			    IF (
			        fato_leitura_hora[nivel_cm] >= Cota
			            && ( ISBLANK ( NivelAnterior ) || NivelAnterior < Cota ),
			        1,
			        0
			    )
		dataType: int64
		formatString: 0
		lineageTag: 99fdf58f-b638-510f-8150-b23412ea73fd
		summarizeBy: none

	column antecedencia_cota_min =
			-- minutos entre o início da sequência contínua em alerta (nivel_cota) e o transbordo (máx. 24 h);
			-- a sequência quebra numa hora fora do alerta ou numa lacuna de leituras
			VAR Est = fato_leitura_hora[estacao_id]
			VAR Idx = fato_leitura_hora[hora_idx]
			RETURN
			    IF (
			        fato_leitura_hora[inicio_transbordo] = 1,
			        VAR InicioAlerta =
			            MAXX (
			                FILTER (
			                    ALL (
			                        fato_leitura_hora[estacao_id],
			                        fato_leitura_hora[hora_idx],
			                        fato_leitura_hora[nivel_cota],
			                        fato_leitura_hora[lacuna_antes]
			                    ),
			                    fato_leitura_hora[estacao_id] = Est
			                        && fato_leitura_hora[hora_idx] <= Idx
			                        && fato_leitura_hora[hora_idx] >= Idx - 24
			                        && (
			                            NOT ( fato_leitura_hora[nivel_cota] IN { "alerta", "alerta_maximo" } )
			                                || fato_leitura_hora[lacuna_antes] = 1
			                        )
			                ),
			                IF (
			                    fato_leitura_hora[nivel_cota] IN { "alerta", "alerta_maximo" },
			                    fato_leitura_hora[hora_idx],
			                    fato_leitura_hora[hora_idx] + 1
			                )
			            )
			        RETURN ( Idx - IF ( ISBLANK ( InicioAlerta ), Idx - 24, InicioAlerta ) ) * 60
			    )
		dataType: double
		formatString: #,0
		lineageTag: 989507d1-e8bc-514e-a185-e7201a078f56
		summarizeBy: none

	column antecedencia_modelo_min =
			-- minutos entre o início da sequência contínua em alerta (nivel_risco) e o transbordo (máx. 24 h);
			-- a sequência quebra numa hora fora do alerta ou numa lacuna de leituras
			VAR Est = fato_leitura_hora[estacao_id]
			VAR Idx = fato_leitura_hora[hora_idx]
			RETURN
			    IF (
			        fato_leitura_hora[inicio_transbordo] = 1,
			        VAR InicioAlerta =
			            MAXX (
			                FILTER (
			                    ALL (
			                        fato_leitura_hora[estacao_id],
			                        fato_leitura_hora[hora_idx],
			                        fato_leitura_hora[nivel_risco],
			                        fato_leitura_hora[lacuna_antes]
			                    ),
			                    fato_leitura_hora[estacao_id] = Est
			                        && fato_leitura_hora[hora_idx] <= Idx
			                        && fato_leitura_hora[hora_idx] >= Idx - 24
			                        && (
			                            NOT ( fato_leitura_hora[nivel_risco] IN { "alerta", "alerta_maximo" } )
			                                || fato_leitura_hora[lacuna_antes] = 1
			                        )
			                ),
			                IF (
			                    fato_leitura_hora[nivel_risco] IN { "alerta", "alerta_maximo" },
			                    fato_leitura_hora[hora_idx],
			                    fato_leitura_hora[hora_idx] + 1
			                )
			            )
			        RETURN ( Idx - IF ( ISBLANK ( InicioAlerta ), Idx - 24, InicioAlerta ) ) * 60
			    )
		dataType: double
		formatString: #,0
		lineageTag: c03c82f4-6543-5ad2-82f0-d741080ede85
		summarizeBy: none

	partition fato_leitura_hora = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaDados & "fato_leitura_hora.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Nulos = Table.TransformColumns(Cabecalho, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(Nulos, {{"estacao_id", type text}, {"bairro_id", type text}, {"hora", type datetime}, {"data", type date}, {"nivel_cm", type number}, {"nivel_var_1h", type number}, {"nivel_var_3h", type number}, {"chuva_1h", type number}, {"chuva_3h", type number}, {"chuva_6h", type number}, {"chuva_24h", type number}, {"umidade_solo_pct", type number}, {"pct_cota_alerta", type number}, {"hora_do_dia", Int64.Type}, {"transbordo_2h", Int64.Type}, {"prob_2h", type number}, {"nivel_cota", type text}, {"nivel_risco", type text}}, [Culture = "en-US"]),
				    HoraIdx = Table.AddColumn(Tipos, "hora_idx", each Number.Round(Duration.TotalHours([hora] - #datetime(2020, 1, 1, 0, 0, 0))), Int64.Type),
				    // seq = ordem da leitura dentro da estação (para achar a leitura anterior mesmo com lacunas)
				    Ordenado = Table.Sort(HoraIdx, {{"estacao_id", Order.Ascending}, {"hora", Order.Ascending}}),
				    PorEstacao = Table.Group(Ordenado, {"estacao_id"}, {{"t", each Table.AddIndexColumn(_, "seq", 1, 1, Int64.Type)}}),
				    Seq = Table.Combine(PorEstacao[t]),
				    Final = Table.TransformColumnTypes(Seq, {{"seq", Int64.Type}, {"hora_idx", Int64.Type}})
				in
				    Final

	annotation PBI_ResultType = Table

