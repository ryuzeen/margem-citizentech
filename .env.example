# Copie para .env (o iniciar.py faz isso sozinho na primeira execução).
# Valores abaixo são APENAS de demonstração acadêmica.

# Chave para assinar os tokens JWT da API. O iniciar.py gera uma aleatória no .env.
MARGEM_JWT_SEGREDO=troque-esta-chave-em-producao
MARGEM_JWT_HORAS=8

# Tokens das estações IoT (HMAC das leituras). Mesmos valores no firmware de demo.
MARGEM_TOKEN_EST_PANTANAL_01=demo-pantanal-7c1f
MARGEM_TOKEN_EST_ITAIM_01=demo-itaim-3b9e
MARGEM_TOKEN_EST_ROMANO_01=demo-romano-a54d
MARGEM_TOKEN_EST_HELENA_01=demo-helena-e02a

# Usuários de demonstração criados no primeiro start
MARGEM_DEMO_CIDADAO_EMAIL=maria@demo.margem.app
MARGEM_DEMO_CIDADAO_SENHA=Margem@2026
MARGEM_DEMO_DEFESA_EMAIL=operador@demo.margem.app
MARGEM_DEMO_DEFESA_SENHA=DefesaCivil@2026

# Servidor
MARGEM_HOST=127.0.0.1
MARGEM_PORTA=8080

# MQTT (opcional): ponte com o ESP32 no Wokwi via broker público
MARGEM_MQTT_ATIVO=0
MARGEM_MQTT_HOST=broker.hivemq.com
MARGEM_MQTT_PORTA=1883

# Kafka (só no modo completo, docker compose)
MARGEM_KAFKA_ATIVO=0
MARGEM_KAFKA_BOOTSTRAP=kafka:9092

# LLM opcional para os agentes (padrão: none = ML + regras, roda offline)
MARGEM_LLM=none
MARGEM_OLLAMA_URL=http://127.0.0.1:11434
MARGEM_OLLAMA_MODELO=llama3.2:3b
